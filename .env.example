# RoomGenie AI — Local Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env to version control or paste secrets into chat.

# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-roomgenie-local-dev-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# For local PostgreSQL or Docker Compose PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=roomgenie_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & Model Providers (Baseline: mock mode for local dev & testing)
# Mode can be 'mock' or 'live'
AI_PROVIDER_MODE=mock
IMAGE_TO_3D_PROVIDER_MODE=mock

# Google Gemini API (Configurable model, requires key only when AI_PROVIDER_MODE=live)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Tripo 3D API (Optional, requires explicit approval & paid credits if enabled)
TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211
