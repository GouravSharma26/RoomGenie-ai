# RoomGenie AI — Local Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env to version control or paste secrets into chat.

# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-roomgenie-local-dev-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# Port 5433 is used by default for Docker Compose to avoid conflicts with native PostgreSQL (port 5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=roomgenie_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & Model Providers (Baseline: mock mode for local dev & testing)
# Mode can be 'mock' or 'live'
AI_PROVIDER_MODE=mock
ROOM_VISION_PROVIDER_MODE=mock
# Image-to-3D Reconstruction Providers ('mock' or 'tripo')
IMAGE_TO_3D_PROVIDER_MODE=mock
IMAGE_TO_3D_ALLOW_PAID_REQUESTS=false
IMAGE_TO_3D_MAX_OUTPUT_SIZE=15728640
IMAGE_TO_3D_TIMEOUT_SECONDS=60

# Tripo 3D API (Optional: live requests require TRIPO_API_KEY AND IMAGE_TO_3D_ALLOW_PAID_REQUESTS=true)
TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211

